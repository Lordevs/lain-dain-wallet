# Copy this file to .env and fill in real values — .env itself is gitignored.

# Backend API base URL — no /api suffix, the generated schema's paths
# already carry it (e.g. "/api/auth/profile/"). In the browser (pnpm dev)
# localhost is fine; on a native simulator/device use your Mac's LAN IP on
# the Django dev server's port (e.g. http://192.168.1.21:8000) — localhost
# inside the device/simulator resolves to the device itself, not your Mac.
VITE_API_BASE_URL=http://localhost:8000

# Capacitor live-reload (native simulator/device only — see
# capacitor_setup_guide.md). Leave unset for a normal `pnpm dev` in the
# browser, or for a production/release build.
# CAPACITOR_LIVE_RELOAD=true
# CAPACITOR_DEV_SERVER_URL=http://<your-lan-ip>:5173
