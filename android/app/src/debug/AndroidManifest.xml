<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only manifest fragment — Gradle's manifest merger combines this
     into src/main/AndroidManifest.xml only for debug-variant builds
     (assembleDebug), leaving release untouched. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true" />
</manifest>
